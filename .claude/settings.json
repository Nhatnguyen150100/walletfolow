{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw:*)",
      "Bash(./mvnw.cmd:*)",
      "Bash(mvn:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(java -version)",
      "Bash(docker ps:*)",
      "Bash(docker info:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.prod*)",
      "Read(./.env.staging*)",
      "Read(./**/application-prod*.yml)",
      "Read(./**/application-prod*.yaml)",
      "Read(./**/application-prod*.properties)",
      "Read(./secrets/**)",
      "Read(./backups/**)",
      "Read(./**/*.jks)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(./mvnw deploy:*)",
      "Bash(mvn deploy:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "env": {
    "CLAUDE_VERIFY_MAX_ATTEMPTS": "3",
    "CLAUDE_VERIFY_GOAL": "verify",
    "CLAUDE_VERIFY_EXTRA_ARGS": "-Dmaven.compiler.proc=full"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-java.sh", "timeout": 120 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.sh", "timeout": 1200 }
        ]
      }
    ]
  }
}
