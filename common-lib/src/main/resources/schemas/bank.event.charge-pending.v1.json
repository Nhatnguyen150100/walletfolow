{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walletflow.dev/schemas/bank.event.charge-pending.v1.json",
  "title": "BankChargePending v1 — phiên thanh toán đã tạo, chờ người dùng trả tiền",
  "description": "Topic bank.event.charge-pending.v1. Producer: bank-adapter. Consumer: transaction-service (saga top-up). KHÔNG phải kết quả thu tiền: kết quả cuối ở bank.event.completed.v1 / bank.event.failed.v1 (ADR-016). eventId tất định theo lần thu, nên phát lại thì consumer dedup được. Luật tiến hoá: chỉ THÊM field optional.",
  "type": "object",
  "required": ["eventId", "eventType", "version", "occurredAt", "tenantId", "payload"],
  "properties": {
    "eventId": { "$ref": "#/$defs/uuid" },
    "eventType": { "const": "BankChargePending" },
    "version": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "tenantId": { "$ref": "#/$defs/uuid" },
    "traceId": { "type": ["string", "null"] },
    "payload": {
      "type": "object",
      "required": ["transactionId", "walletId", "provider", "providerRef", "paymentUrl"],
      "properties": {
        "transactionId": { "$ref": "#/$defs/uuid" },
        "walletId": { "$ref": "#/$defs/uuid" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 32 },
        "providerRef": { "type": "string", "minLength": 1, "maxLength": 128 },
        "paymentUrl": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
  }
}
