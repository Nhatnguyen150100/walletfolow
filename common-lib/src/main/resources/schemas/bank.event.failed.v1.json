{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walletflow.dev/schemas/bank.event.failed.v1.json",
  "title": "BankFailed v1 — thao tác với provider thất bại dứt khoát",
  "description": "Topic bank.event.failed.v1. Producer: bank-adapter. Consumer: transaction-service. Chỉ cho thất bại DỨT KHOÁT (provider từ chối, hoặc xác nhận phiên hỏng/hết hạn); lỗi kỹ thuật không bao giờ thành event này mà đi retry -> DLT. providerRef null khi bị từ chối ngay lúc tạo phiên. Chỉ mang failureCode ổn định. Luật tiến hoá: chỉ THÊM field optional; failureCode mới phải được consumer xử lý như 'lỗi không biết'.",
  "type": "object",
  "required": ["eventId", "eventType", "version", "occurredAt", "tenantId", "payload"],
  "properties": {
    "eventId": { "$ref": "#/$defs/uuid" },
    "eventType": { "const": "BankFailed" },
    "version": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "tenantId": { "$ref": "#/$defs/uuid" },
    "traceId": { "type": ["string", "null"] },
    "payload": {
      "type": "object",
      "required": ["transactionId", "operation", "walletId", "provider", "failureCode"],
      "properties": {
        "transactionId": { "$ref": "#/$defs/uuid" },
        "operation": { "enum": ["CHARGE", "REFUND", "PAYOUT"] },
        "walletId": { "$ref": "#/$defs/uuid" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 32 },
        "providerRef": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }] },
        "failureCode": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
  }
}
