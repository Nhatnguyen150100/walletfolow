<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.0</version>
    <relativePath />
  </parent>

  <groupId>com.walletflow</groupId>
  <artifactId>walletflow-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>walletflow-parent</name>
  <description>WalletFlow - Hệ thống Ví điện tử Microservices (double-entry ledger, Saga, idempotency)</description>

  <properties>
    <java.version>21</java.version>
    <spring-cloud.version>2025.0.0</spring-cloud.version>
    <jjwt.version>0.12.6</jjwt.version>
    <springdoc.version>2.8.8</springdoc.version>
    <testcontainers.version>1.20.4</testcontainers.version>
    <!-- docker-java (lõi của Testcontainers) mặc định chào Docker API 1.32, trong khi
         Docker Engine >= 25 chỉ chấp nhận >= 1.40 -> "client version 1.32 is too old".
         Nâng Testcontainers KHÔNG khắc phục được; phải chỉ định api.version tường minh.
         Docker quá cũ thì ghi đè: mvn verify -Ddocker.api.version=1.41 -->
    <docker.api.version>1.44</docker.api.version>
  </properties>

  <!-- Milestone 0: hạ tầng + auth + common-lib.
       Các service nghiệp vụ (wallet/ledger/transaction/bank-adapter/notification)
       sẽ được thêm vào ở các milestone sau. -->
  <modules>
    <module>common-lib</module>
    <module>infrastructure/discovery-server</module>
    <module>infrastructure/config-server</module>
    <module>infrastructure/api-gateway</module>
    <module>services/auth-service</module>
    <module>services/ledger-service</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
