<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath />
  </parent>

  <groupId>com.walletflow</groupId>
  <artifactId>walletflow-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>walletflow-parent</name>
  <description>WalletFlow - Hệ thống Ví điện tử Microservices (double-entry ledger, Saga, idempotency)</description>

  <properties>
    <java.version>21</java.version>
    <spring-cloud.version>2025.1.3</spring-cloud.version>
    <jjwt.version>0.12.6</jjwt.version>
    <springdoc.version>2.8.8</springdoc.version>
    <testcontainers.version>1.20.4</testcontainers.version>
    <jacoco.version>0.8.15</jacoco.version>
    <!-- Validate message Kafka với JSON Schema trong contract test (roadmap 1.3) -->
    <json-schema-validator.version>1.5.6</json-schema-validator.version>
    <!-- docker-java (lõi của Testcontainers) mặc định chào Docker API 1.32, trong khi
         Docker Engine >= 25 chỉ chấp nhận >= 1.40 -> "client version 1.32 is too old".
         Nâng Testcontainers KHÔNG khắc phục được; phải chỉ định api.version tường minh.
         Docker quá cũ thì ghi đè: mvn verify -Ddocker.api.version=1.41 -->
    <docker.api.version>1.44</docker.api.version>
  </properties>

  <!-- Milestone 0: hạ tầng + auth + common-lib.
       Các service nghiệp vụ (wallet/ledger/transaction/bank-adapter/notification)
       sẽ được thêm vào ở các milestone sau. -->
  <modules>
    <module>common-lib</module>
    <module>infrastructure/discovery-server</module>
    <module>infrastructure/config-server</module>
    <module>infrastructure/api-gateway</module>
    <module>services/auth-service</module>
    <module>services/ledger-service</module>
    <module>services/wallet-service</module>
    <module>services/transaction-service</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
      <!-- Helper contract test (EventSchemas) dùng chung cho mọi service -->
      <dependency>
        <groupId>com.walletflow</groupId>
        <artifactId>common-lib</artifactId>
        <version>1.0.0</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
        <!-- spring-boot-starter-parent KHÔNG quản version của jacoco, nên phải pin ở đây.
             Để Maven tự chọn phiên bản mới nhất là nguồn của những lần build khác nhau
             giữa máy dev và CI mà không ai đổi gì. -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Đo độ phủ cho CẢ unit test lẫn integration test.
           prepare-agent-integration + report-integration là phần hay bị quên: phần lớn
           giá trị kiểm chứng của dự án này nằm ở các test *IT (Testcontainers), nên một
           báo cáo chỉ tính surefire sẽ cho con số thấp giả và nói sai về chất lượng. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>prepare-agent-integration</id>
            <goals>
              <goal>prepare-agent-integration</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
              <goal>report-integration</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
