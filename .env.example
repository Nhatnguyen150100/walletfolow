# =====================================================================
# WalletFlow — mẫu biến môi trường.
#   cp .env.example .env && ./scripts/gen-keys.sh
#
# File .env THẬT không bao giờ được commit (xem .gitignore).
#
# Nguyên tắc: KHÔNG có giá trị mặc định cho bí mật ở bất kỳ application.yml nào.
# Thiếu biến thì service phải CHẾT LÚC KHỞI ĐỘNG, không được âm thầm chạy bằng
# giá trị dev — vì giá trị dev đó chắc chắn sẽ theo lên production một ngày nào đó.
# =====================================================================

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=walletflow
DB_PASS=walletflow

# ---- Hạ tầng ----
KAFKA_BROKERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379
OTLP_ENDPOINT=http://localhost:4318/v1/traces
EUREKA_URL=http://localhost:8761/eureka/
CONFIG_SERVER_URL=http://localhost:8888

# ---- JWT (RS256) ----
# Sinh bằng: ./scripts/gen-keys.sh  — script sẽ ghi đè hai dòng dưới đây.
#
# auth-service giữ PRIVATE key và KÝ token.
# api-gateway chỉ cần PUBLIC key (lấy qua JWKS) và chỉ VERIFY được.
# Đây là lý do dùng cặp khoá bất đối xứng thay vì một secret chia sẻ: gateway bị
# chiếm cũng không phát hành được token.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=

# Hạn access token (giây). 15 phút — đủ ngắn để token lọt ra ngoài không thành thảm hoạ,
# đủ dài để không phải refresh liên tục.
JWT_ACCESS_TTL_SECONDS=900
# Hạn refresh token (ngày).
JWT_REFRESH_TTL_DAYS=30

# URL JWKS mà gateway dùng để lấy public key của auth-service.
JWKS_URI=http://localhost:8081/.well-known/jwks.json

# ---- Tenant (ADR-010, ADR-011) ----
# Định danh, KHÔNG phải bí mật — có mặc định là tenant của giai đoạn một khách hàng.
# Tenant mà endpoint đăng ký/đăng nhập công khai phục vụ. Không bao giờ lấy từ request.
AUTH_TENANT_ID=00000000-0000-0000-0000-000000000001
# Tenant được ledger cấp tài khoản hệ thống lúc khởi động (phân cách bằng dấu phẩy).
LEDGER_PROVISION_TENANTS=00000000-0000-0000-0000-000000000001

# ---- Cổng thanh toán (bank-adapter, ADR-016) ----
# BẮT BUỘC, không có mặc định trong application.yml. `mock` = provider giả trong bộ nhớ, KHÔNG thu tiền
# thật — chỉ cho máy dev/CI. `vnpay` (2.2b) sẽ cần thêm khoá sandbox ở đây.
BANK_PROVIDER=mock
# Xác nhận thứ hai để chạy `mock` (mặc định false). Môi trường thật KHÔNG BAO GIỜ đặt biến này;
# bank-adapter còn từ chối mock dưới profile `prod` bất kể giá trị của nó.
BANK_MOCK_ALLOWED=true
